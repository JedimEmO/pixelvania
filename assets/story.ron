// The night's words: what the guests who talk say, the Host's cards, and the scenes' lines.
// docs/design/story.md is where these are decided; keep the two in step.
// A guest's `lines` are tried from last to first: the last whose `when` abilities have all been
// found is the one spoken. `look` picks the guest's rig: light, medium, heavy, spinner or toaster.
(
    guests: {
        "attendant": (
            name: "The attendant",
            look: "light",
            lines: [
                (when: [], say: [
                    "Ticket? No? Nobody keeps their ticket.",
                    "I have hung every coat in this house. Not one has been asked for back.",
                    "Go on through. They are all through there.",
                ]),
                (when: [Lunge], say: [
                    "In a hurry. Everyone is, the first night.",
                    "It passes.",
                ]),
                (when: [Lure], say: [
                    "You have the look of someone who has seen the chandeliers up close.",
                    "Mind the moths. They never stop either.",
                ]),
            ],
        ),
        "porter": (
            name: "The porter",
            look: "heavy",
            lines: [
                (when: [], say: [
                    "Bags? No bags. Nobody brings anything.",
                    "Nobody takes anything away, either.",
                    "I keep the little door. He keeps the big one, up the stair.",
                ]),
                (when: [Cling], say: [
                    "Up the stair, are you? He'll be at the inner doors. He always is.",
                    "He lets everyone in. I have never seen him let anyone out.",
                ]),
                (when: [Plunge], say: [
                    "Heard a floor go, somewhere. Doesn't happen often.",
                    "Happens every night.",
                ]),
            ],
        ),
        "pianist": (
            name: "The pianist",
            look: "medium",
            lines: [
                (when: [], say: [
                    "Request? I only know the one.",
                    "I have played it so long I've forgotten how it ends. Perhaps it doesn't.",
                    "Rest, if you like. Everyone rests here before they meet him.",
                ]),
                (when: [Lure], say: [
                    "You got past him. Then you've heard the real band.",
                    "Don't tell me what they're like. I'd rather imagine.",
                ]),
            ],
        ),
        "partner": (
            name: "The partner",
            look: "medium",
            lines: [
                (when: [], say: [
                    "You're going to see her. Of course you are.",
                    "I kept up with her for... I don't know. A long time. Then I couldn't.",
                    "She never notices when you stop. She just finds someone new.",
                ]),
                (when: [Plunge], say: [
                    "The music stopped. I heard it stop.",
                    "I thought I would be glad.",
                ]),
            ],
        ),
        "bandleader": (
            name: "The bandleader",
            look: "heavy",
            lines: [
                (when: [], say: [
                    "One more, she said. One more and then we'll all go to bed.",
                    "That was the last request I took.",
                    "Listen. Can you hear them? I can always hear them.",
                ]),
                (when: [Plunge], say: [
                    "The tempo's gone. Who's keeping time?",
                ]),
            ],
        ),
        "wallflower": (
            name: "The wallflower",
            look: "spinner",
            lines: [
                (when: [], say: [
                    "I'm going to ask her. Tonight. In a moment.",
                    "Once I have had a little air.",
                ]),
                (when: [Swoon], say: [
                    "It goes to your head, doesn't it. The height. All of it.",
                ]),
                (when: [Plunge], say: [
                    "She isn't dancing any more? Then I've missed it.",
                    "Well. There will be another.",
                ]),
            ],
        ),
        "card_player": (
            name: "The card player",
            look: "toaster",
            lines: [
                (when: [], say: [
                    "Sit, sit. Stakes are low. Everything is low, by now.",
                    "Nectar's no good for anything but drinking. So drink it.",
                    "Drink it and the room comes alive again. For a while. Less each time.",
                ]),
                (when: [Lure], say: [
                    "I used to play for the chandeliers. Imagine. Climbing for them.",
                ]),
            ],
        ),
        "gourmand": (
            name: "The gourmand",
            look: "heavy",
            lines: [
                (when: [], say: [
                    "I have eaten here every night. Every course.",
                    "Ask me what I had. Go on. No? Neither can I.",
                    "Rest, if you like. The next course is always coming.",
                ]),
                (when: [Swoon], say: [
                    "You've been to the end of the table. Did he save you anything?",
                    "He never does. He never stops, either.",
                ]),
            ],
        ),
        "sleeper_at_table": (
            name: "A guest, lying down",
            look: "light",
            lines: [
                (when: [], say: [
                    "Shh. I'm digesting.",
                    "Went to the end of the table. You don't come back from the end of the table.",
                    "You just lie down for a bit. Get up, though. Someone should.",
                ]),
                (when: [Swoon], say: [
                    "Light-headed? That's the trick of it.",
                    "When you feel yourself go, go up instead of down.",
                ]),
            ],
        ),
    },
    cards: {
        "vestibule": "You are expected. Do come through.  - H.",
        "coat_check": "Leave whatever you came in with. You will not need it.  - H.",
        "feast_doors": "Not these doors, darling. The feast is served upstairs, for those who can climb.  - H.",
        "larder": "There is more here than anyone could eat. That was never the point.  - H.",
        "garden_doors": "The gardens are not yet in bloom. Patience is not your gift, is it?  - H.",
        "letter_room": "Your invitation was never sent. You came anyway. How like you.  - H.",
        "inner_doors": "Through here. Everyone is through here.  - H.",
        "antechamber": "You found your way in. They always do.  - H.",
        "cloakroom": "Nobody has come back for these. Nobody will.  - H.",
        "champagne_cellar": "Take what you like. There is always more.  - H.",
        "mirror_corridor": "Look how well you are doing.  - H.",
        "green_room": "She has been waiting for a partner who can keep up. Can you?  - H.",
        "cellar": "Still here? How lovely. The night is young.  - H.",
    },
    waking: "You are late.",
    ending: "The night goes on.",
    // Each boss speaks a line as each phase of its fight begins, and one as it falls.
    bosses: {
        "doorman": (
            phases: ["Name?", "You're not on the list.", "Nobody leaves. Everyone's inside."],
            fall: "Go on through, then. They all do.",
        ),
        "glutton": (
            phases: ["Hungry? There's plenty.", "More. Bring more.", "I can't stop. I don't know how."],
            fall: "Is that all? Is there no more?",
        ),
        "dancer": (
            phases: [
                "There you are. Dance with me.",
                "Faster. Faster!",
                "Don't let it stop. Don't let it stop.",
            ],
            fall: "Was it lovely? Tell me it was lovely.",
        ),
    },
)
