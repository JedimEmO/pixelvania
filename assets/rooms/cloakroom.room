// The cloakroom: coats on rails stacked down a deep well.
//
// Drop from the antechamber's door at the top right down the rails to the cellar door at the bottom,
// or climb back up them. A side door halfway down leads to the smoking room.
[room]
name = cloakroom
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet

