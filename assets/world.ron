    start: "antechamber",
    rooms: [
        (name: "antechamber", area: "ballroom", pos: Some((0, 16))),
        (name: "ballroom", area: "ballroom", pos: Some((44, 0))),
        (name: "cloakroom", area: "ballroom", pos: Some((-40, 31))),
        (name: "smoking_room", area: "ballroom", pos: Some((-84, 38))),
        (name: "balcony", area: "ballroom", pos: Some((-64, 0))),
        (name: "powder_room", area: "ballroom", pos: Some((-100, 6))),
        (name: "upper_gallery", area: "ballroom", pos: Some((0, -8))),
        (name: "card_room", area: "ballroom", pos: Some((-44, -23))),
        (name: "crystal_gallery", area: "ballroom", pos: Some((44, -24))),
        (name: "stair_tower", area: "ballroom", pos: Some((108, -40))),
        (name: "mirror_corridor", area: "ballroom", pos: Some((140, -40))),
        (name: "bandstand", area: "ballroom", pos: Some((140, -17))),
