// The Sleeper's bower: a bed of flowers grown over a guest who will not wake, and must not be woken.
//
// In high on the west, onto a ledge, and down to the floor. The arena is open, with blooms
// overhead to hang from when the floor is no place to be. East is the summerhouse.
[room]
name = sleepers_bower
background = ballroom 1a4a40
music = gardens

[legend]
# stone
g gilt

