// The mirrored corridor: a long hall that is the same on both sides of its middle.
//
// Run it from the stair tower to the fly loft, past dancers and their reflections,
// over the sunken floor at each end or by the chandeliers.
[room]
name = mirror_corridor
background = ballroom
music = ballroom

[legend]
# stone
g gilt

