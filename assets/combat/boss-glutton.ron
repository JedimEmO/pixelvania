// The Glutton's moves, in ticks at 120 Hz. His brain in crates/game/src/glutton.rs picks which to
// start, ends the hop when he lands and starts the landing then, and stops the gorge when he chokes.
// Hitboxes are relative to the middle of his feet, facing right, y up negative.
(
    name: "boss-glutton",
    charge_ticks: 120,
    combo: (
        // The swipe: the magnum swung wide from over the shoulder.
        (
        windup: 50, active: 12, recovery: 80, cancel_window: 4,
        hitboxes: [(rect: (x: 4.0, y: -62.0, w: 78.0, h: 56.0), ticks: None)],
        damage: 16.0, poise_damage: 34.0, hit_stop: 0.11,
        knockback: (240.0, -120.0), launches: false,
        weight: Heavy, armour: false, step: None,
        chain: None, air_hang: 0,
    ),
        // The hop: a deep, wobbling crouch, then up and at the player. No hit of its own;
        // the brain ends it when he lands, which starts the landing.
        (
        windup: 66, active: 240, recovery: 1, cancel_window: 0,
        hitboxes: [],
        damage: 0.0, poise_damage: 0.0, hit_stop: 0.0,
        knockback: (0.0, 0.0), launches: false,
        weight: Heavy, armour: true, step: None,
        chain: None, air_hang: 0,
    ),
        // The landing: his weight on the floor under him, and the floor shaking out both ways,
