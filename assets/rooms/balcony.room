// The balcony over the gardens: a long terrace under an awning of lanterns, open to the night.
//
// Enter from the antechamber at the bottom right. At the rail the night air makes the head spin:
// the Swoon is found there, beside the wallflower. Planters climb the terrace, each a Swoon
// below a ledge: west to the powder room, east to the upper gallery.
[room]
name = balcony
background = ballroom
music = ballroom

[legend]
# stone
v velvet
g gilt

