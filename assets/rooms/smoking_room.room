// The smoking room: a low, hazy room of booths off the cloakroom.
//
// A Carnation waits on a gilt shelf hung high in the middle of the room, out of reach of every wall.
// Swing to it from either lantern. The floor under the shelf is cracked.
[room]
name = smoking_room
background = ballroom
music = ballroom

[legend]
# stone
v velvet
g gilt
x cracked

