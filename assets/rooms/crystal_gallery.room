// The crystal gallery: a long room of chandeliers above the ballroom.
//
// Swing from chandelier to chandelier to the stair tower door at the top right,
// or walk the floor and climb the wall at the far end.
[room]
name = crystal_gallery
background = ballroom
music = ballroom

[legend]
# stone
g gilt

