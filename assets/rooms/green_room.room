// The green room: dressing rooms stacked behind the stage, with a lounge by the mirrors.
//
// Enter from the bandstand at the top left. Rest at the lounge, then go down to the stage door
// at the bottom right. The door halfway down drops to the side hall.
[room]
name = green_room
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet
g gilt

