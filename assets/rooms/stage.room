// The stage, where the Dancer is fought.
//
// Enter from the green room on the left. The middle of the stage floor is cracked;
// when the fight ends it gives way, and the fall leads to the cellar below.
[room]
name = stage
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet
x cracked

