// The crystal gallery: a long room of chandeliers above the ballroom.
//
// Enter from the stair tower at the top right. A moth circles the chandeliers, and on a gilt perch
// eight tiles above the floor waits a Favour: Swoon up to it. Walk on to the upper gallery's door
// at the bottom left, or swing from chandelier to chandelier.
[room]
name = crystal_gallery
background = ballroom
music = ballroom

[legend]
# stone
g gilt

