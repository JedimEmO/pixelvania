// The champagne cellar: racks of bottles under the ballroom, with a lounge among them.
//
// Run it between the champagne stair and the wine vault. The racks carry a way above the floor.
// One patch of the floor is cracked.
[room]
name = champagne_cellar
background = ballroom
music = ballroom

[legend]
# stone
= wood
x cracked

