// The upper gallery: portraits above the antechamber.
//
// Enter from the balcony at the bottom left. The door at the bottom right opens into the ballroom's alcove.
// Climb the portrait ledges, or swing from the chandelier, to the walkways at the top:
// west to the card room, east to the crystal gallery.
[room]
name = upper_gallery
background = ballroom
music = ballroom

[legend]
# stone
g gilt

