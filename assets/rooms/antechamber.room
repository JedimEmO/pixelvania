// The antechamber: a quiet waiting room between the gardens and the ballroom.
//
// A new game wakes here, on the chaise, with the Host's first card beside it.
// Music comes through the wall from the ballroom, whose door is at the right end of the floor.
// Two doors in the left wall lead west: to the cloakroom from the floor, and to the balcony
// from the ledge, which only a Cling reaches.
[room]
name = antechamber
background = ballroom
music = ballroom

[legend]
