// The upper gallery: portraits above the antechamber.
//
// Enter from the balcony at the bottom left, or from the crystal gallery's walkway at the top right.
// Climb the portrait ledges to that walkway. The card room's walkway, top left, is a Swoon up
// from the lowest ledge, and the chandelier swings to both.
[room]
name = upper_gallery
background = ballroom
music = ballroom

[legend]
# stone
v velvet
g gilt

