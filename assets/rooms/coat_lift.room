// The coat lift: the shaft of a dumbwaiter for coats, long since stopped.
//
// The door from the coat check opens high in the west wall; the shaft drops to the bottom,
// where a pair of long silk gloves hang over the cage: they give the Cling, and the way back up.
// A Favour waits on a ledge high on the east wall.
[room]
name = coat_lift
background = cellars 8a5a30
music = ballroom muffled

[legend]
