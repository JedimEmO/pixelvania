// The kitchens: hot, loud, and never finished. Ovens stand on the floor like furniture.
//
// Enter high on the west from the banquet hall; shelves zigzag down to the floor and back.
// A Goblet sits on a shelf near the east wall; cling up the wall past it, then step across.
// The larder is off the floor to the east.
[room]
name = kitchens
background = cellars 8a3a18
music = ballroom muffled

[legend]
# stone
= wood

