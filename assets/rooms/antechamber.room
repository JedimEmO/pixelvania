// The antechamber: a quiet room between the gardens and the ballroom.
//
// The vertical slice starts here. Music comes through the wall from the ballroom,
// whose door is at the right end of the floor. A lounge waits at the left end.
// Two doors in the left wall lead west: to the cloakroom from the floor, and to the balcony from the ledge.
[room]
name = antechamber
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet
g gilt

