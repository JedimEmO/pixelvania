// The Doorman's three moves, in ticks at 120 Hz. His brain in crates/game/src/doorman.rs picks
// which to start and shortens the recoveries as the fight goes on; these are the first phase's.
// Hitboxes are relative to the middle of his feet, facing right, y up negative.
(
    name: "boss-doorman",
    charge_ticks: 120,
    combo: (
        // The shove: the staff held level and driven forward. Throws the player back.
        (
        windup: 54, active: 14, recovery: 84, cancel_window: 4,
        hitboxes: [(rect: (x: 6.0, y: -44.0, w: 58.0, h: 30.0), ticks: None)],
        damage: 14.0, poise_damage: 30.0, hit_stop: 0.1,
        knockback: (260.0, -90.0), launches: false,
        weight: Heavy, armour: false, step: None,
        chain: None, air_hang: 0,
    ),
        // The knock: the staff struck on the floor. A line runs out along the floor both ways,
        // growing; jump it. The staff's own blow is the first box.
        (
        windup: 78, active: 30, recovery: 90, cancel_window: 4,
        hitboxes: [
            (rect: (x: 8.0, y: -24.0, w: 30.0, h: 24.0), ticks: Some((start: 0, end: 6))),
