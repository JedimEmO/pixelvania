// The side hall: a long hall between the stair and the green room, where a dancer spins.
//
// Run it along the floor. The door to the green room is on a gilt shelf too high to reach from the floor;
// from the green room it is a drop, and a quick way back to the ballroom.
[room]
name = side_hall
background = ballroom
music = ballroom

[legend]
# stone
g gilt

