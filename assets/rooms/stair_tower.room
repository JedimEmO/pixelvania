// The stair tower: landings stacked up a tall well beside the ballroom.
//
// Enter from the bandstand at the bottom right or the crystal gallery on the left.
// Climb the landings, swing from the lanterns, or cling to the walls,
// up to the mirrored corridor at the top right.
[room]
name = stair_tower
background = ballroom
music = ballroom

[legend]
# stone
= wood

