// The cloakroom: coats nobody came back for, on rails stacked down a deep well.
//
// Drop from the antechamber's door at the top right down the rails to the empty counter at the bottom,
// where a Favour was left among the tickets nobody came back for.
// The way on to the wine vault is over a pit too wide to jump: Lunge across it.
// A side door halfway down leads to the smoking room.
[room]
name = cloakroom
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet

