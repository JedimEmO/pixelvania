// The champagne stair: a landing over a stairwell that winds down to the cellars.
//
// Cross the landing from the ballroom to the side hall, over the gap or by the chandelier,
// or go down the flights to the champagne cellar door at the bottom left.
[room]
name = champagne_stair
background = ballroom
music = ballroom

[legend]
# stone
= wood
g gilt

