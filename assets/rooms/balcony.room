// The balcony over the gardens: a long terrace under an awning of lanterns.
//
// Enter from the antechamber at the bottom right. Run the terrace west to the powder room.
// The gallery door at the top right sits on a ledge no wall reaches:
// swing up the awning's lanterns to it.
[room]
name = balcony
background = ballroom
music = ballroom

[legend]
# stone
v velvet
g gilt

