// The portrait hall: guests of other nights on the walls, and some of this one on the floor.
//
// East is the music room. A gap in the floor at the east end drops to the vestibule below,
// the way home to the first lounge.
[room]
name = portrait_hall
background = foyer a06030
music = ballroom

[legend]
# stone
= wood
g gilt

