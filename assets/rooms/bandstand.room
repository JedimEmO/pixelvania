// The bandstand: the orchestra's risers under one great chandelier, instruments set down mid-song.
//
// The bandleader still conducts from the podium. Cross from the stair tower over the risers to the
// green room door at the bottom right. The box at the top right, reached by the chandeliers,
// opens into the fly loft.
[room]
name = bandstand
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet
g gilt

