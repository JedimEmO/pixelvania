// The champagne cellar: racks of bottles under the ballroom, with a lounge among them.
//
// From the champagne stair, the way in stops at a trench where a rack gave way: Lunge across it.
// Beyond are the racks, climbable to the largest bottle of all, the Jeroboam,
// and the wine vault's door at the west end. A step in the trench lets a fall climb back out.
[room]
name = champagne_cellar
music = ballroom

[legend]
# stone
= wood

