// The green room: dressing rooms stacked behind the stage, with a lounge by the mirrors.
//
// Enter from the bandstand at the top left, or from the side hall below it. Steps climb between them
// and up from the costume store at the bottom, where the Dancer's partner sits at a mirror.
// The way to the stage is a passage over the store's ceiling, through a hole in it
// that nothing reaches but the Lure: swing up from the chandeliers.
[room]
name = green_room
music = ballroom

[legend]
= wood
v velvet

