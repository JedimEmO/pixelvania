// The combat lab: a walled hall to fight guests in. Tiles are 16 x 16; entity positions are in tiles.
//
// Walls on both sides for wall splats, a wooden balcony at each end, and a stone dais in the middle.
// One guest of each weight class waits along the floor: light, medium and heavy.
[room]
name = arena
background = ballroom
music = ballroom

[legend]
# stone
= wood

