// The stair tower: landings up a tall well beside the bandstand, under a cold window.
//
// Enter from the bandstand at the bottom right. Two landings climb to the banister where a pair of
// long silk gloves hang: they give the Cling. Above them the well is sheer:
// cling up the west wall to the crystal gallery's door, then climb the landings
// to the mirrored corridor at the top right.
[room]
name = stair_tower
background = ballroom
music = ballroom

[legend]
# stone
= wood

