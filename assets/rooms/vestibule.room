// The vestibule: the house's front hall, where a new game wakes.
//
// The front doors at the west end are shut, and stay shut until the end of the night.
// A chaise waits by them with the Host's first card. The way on is east, to the receiving line.
// The opening in the ceiling is where the portrait hall above drops back down: a way home, one way.
[room]
name = vestibule
background = foyer a06030
music = ballroom muffled

[legend]
