// The ballroom: one finished room. Tiles are 16 x 16; entity positions are in tiles.
//
// A hall built for the Lure, entered from the antechamber through the door at the dance floor's left end. The dance floor runs along the bottom, with a sunken orchestra pit
// to its right and a tall shaft beyond. Chandeliers lead from the floor up to a gilt gallery,
// lanterns light the way up the shaft, and one last chandelier swings to a lounge in the upper left.
[room]
name = ballroom
background = ballroom
music = ballroom

[legend]
# stone
= wood
v velvet
g gilt

